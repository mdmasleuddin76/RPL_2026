# Copy to .env on the server and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

APP_PORT=8004
FRONTEND_URL=https://cricket.maslecodes.fun

# MongoDB (mongo:4.4 because this server's CPU has no AVX)
MONGO_IMAGE=mongo:4.4
MONGO_ROOT_USER=rpl_admin
MONGO_ROOT_PASSWORD=

REDIS_PASSWORD=
JWT_SECRET=

# Admin login created by: docker compose exec backend node src/create.js
ADMIN_EMAIL=
ADMIN_PASSWORD=
